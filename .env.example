# Copy to .env (scripts/setup_local.sh does this for you). Never commit .env.

# --- Database (shared by Docker Compose and the locally run backend) ---
POSTGRES_DB=multimodal_retrieval
POSTGRES_USER=app_user
# Production: use a long random value, e.g. `openssl rand -hex 24` (hex avoids URL-escaping issues).
# The password is fixed when the database volume is first created; changing it later
# requires ALTER USER inside the database (or deleting the volume, which deletes data).
POSTGRES_PASSWORD=local_dev_password
# Used by the backend when run outside Docker; must match the values above. Compose builds its own.
DATABASE_URL=postgresql+psycopg://app_user:local_dev_password@127.0.0.1:5433/multimodal_retrieval

# DATA_DIR defaults to this repository's data directory.
# DATA_DIR=/absolute/path/to/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_LANGUAGE=eng
# TESSERACT_CMD=/usr/bin/tesseract

# PyTorch wheel index. CPU is default; for NVIDIA use https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Web deployment only (docker-compose.prod.yml) ---
# Domain pointed at the server (DNS A/AAAA record) for automatic HTTPS, or ":80" for plain HTTP.
SITE_ADDRESS=:80
# Login required for the whole site in production.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
