# Copy to .env and adjust. Never commit .env.
# All values are read by Docker Compose; nothing else needs to be installed.

# --- Database ---
POSTGRES_DB=multimodal_retrieval
POSTGRES_USER=app_user
# For a web server use a long random value, e.g. `openssl rand -hex 24` (hex avoids URL-escaping issues).
# The password is fixed when the database volume is first created; changing it later
# requires ALTER USER inside the database (or deleting the volume, which deletes data).
POSTGRES_PASSWORD=local_dev_password

# --- Running on your machine ---
# Web app port on 127.0.0.1 (http://127.0.0.1:5173).
ATLAS_PORT=5173

# --- Backend image ---
# 1 = bake models into the image (bigger image, no runtime downloads). 0 = download on first use.
PRELOAD_MODELS=1
# PyTorch wheel index. CPU is default; for NVIDIA use https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
OCR_LANGUAGE=eng
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=

# --- Web deployment only (docker-compose.prod.yml) ---
# Domain pointed at the server (DNS A/AAAA record) for automatic HTTPS, or ":80" for plain HTTP.
SITE_ADDRESS=:80
# Login required for the whole site in production.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
